{
  "name": "universal-compress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Universal Simulation Ltd",
  "description": "Universal Compress — drop any file, make it smaller. PDFs, video, images and audio compressed entirely in your browser, nothing uploaded.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "credits": "node ../scripts/gen-credits.mjs . --repo https://github.com/universal-simulation-ltd/Universal_Compress",
    "test": "vitest run",
    "test:gif": "node scripts/gif-selftest.mjs",
    "test:watch": "vitest",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "cap:sync": "npm run build:desktop && npx cap sync && npm run check:mobile-bundle && npm run check:ios-launch",
    "check:mobile-bundle": "node scripts/verify-mobile-bundle.mjs",
    "check:ios-launch": "node scripts/verify-ios-launch.mjs",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@unisim/media": "^0.7.0",
    "@unisim/sdk": "^0.180.3",
    "heic-to": "^1.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
